Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 550
  - Class: rviz_common/Views
    Name: Views
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.4
      Cell Size: 1
      Color: 160; 160; 164
      Plane Cell Count: 30
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 190; 190; 190
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Boat pose and yaw
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Value: Arrow
        Color: 0; 170; 255
        Axes Length: 1
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Three camera bearings
      Enabled: true
      Topic:
        Value: /dock/bearing_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Independent LiDAR RANSAC normals
      Enabled: true
      Topic:
        Value: /dock/lidar/direct_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Selected LiDAR wall
      Enabled: true
      Topic:
        Value: /dock/lidar/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Dock via and stop goals
      Enabled: true
      Topic:
        Value: /dock/avoid/goal_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Fixed GPS LOS route
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 220; 0
      Line Style: Billboards
      Line Width: 0.12
      Pose Style: None
      Topic:
        Value: /dock/one_shot_path
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 13
      Focal Point:
        X: 66
        Y: 66
        Z: 0
      Name: Current View
      Pitch: 1.3
      Target Frame: <Fixed Frame>
      Yaw: 0.7
      Value: Orbit (rviz_default_plugins)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1300
  X: 50
  Y: 50
