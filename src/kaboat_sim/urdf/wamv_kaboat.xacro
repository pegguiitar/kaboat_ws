<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wamv_kaboat">

  <xacro:include filename="$(find wamv_gazebo)/urdf/wamv_gazebo.urdf.xacro" />
  <xacro:include filename="$(find wamv_description)/urdf/thrusters/engine.xacro" />

  <link name="cpu_box_link">
    <visual>
      <geometry><box size="0.4 0.3 0.2"/></geometry>
      <material name="cpu_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.2"/></geometry>
    </collision>
  </link>
  <joint name="cpu_box_joint" type="fixed">
    <parent link="wamv/base_link"/>
    <child link="cpu_box_link"/>
    <origin xyz="0.0 0.0 1.3" rpy="0 0 0"/>
  </joint>

  <link name="sensor_pole_link">
    <visual>
      <geometry><cylinder radius="0.02" length="0.4"/></geometry>
      <material name="pole_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="sensor_pole_joint" type="fixed">
    <parent link="cpu_box_link"/>
    <child link="sensor_pole_link"/>
    <origin xyz="0.1 0.0 0.3" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="lidar_blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.23" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/lidar/scan</topic>

      <gz_frame_id>lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range><min>0.1</min><max>50.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.1 0.03"/></geometry>
      <material name="cam_black"><color rgba="0.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0.0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/depth</topic> 
      
      <gz_frame_id>camera_link</gz_frame_id>
      
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>