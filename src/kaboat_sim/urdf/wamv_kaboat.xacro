<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wamv_kaboat">

  <!-- 크기 조정 가능한 선체 (base_link, 엔진, 배터리, 부력/유체동역학, 추력,
       상태 퍼블리셔 + 스케일 파라미터 s 를 여기서 정의한다).
       배 크기는 kaboat_hull.xacro 의 target_length 하나로 조정. -->
  <xacro:include filename="$(find kaboat_sim)/urdf/kaboat_hull.xacro" />

  <!-- 위 include 에서 정의된 s(= target_length/base_length)를 그대로 사용해
       센서 장착부(높이·크기)도 동일 비율로 축소한다. 센서 성능값(라이다 사거리,
       카메라 FOV/해상도 등)은 물리 치수가 아니므로 스케일하지 않는다. -->

  <link name="cpu_box_link">
    <visual>
      <geometry><box size="${0.4*s} ${0.3*s} ${0.2*s}"/></geometry>
      <material name="cpu_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${0.4*s} ${0.3*s} ${0.2*s}"/></geometry>
    </collision>
  </link>
  <joint name="cpu_box_joint" type="fixed">
    <parent link="wamv/base_link"/>
    <child link="cpu_box_link"/>
    <origin xyz="0.0 0.0 ${1.3*s}" rpy="0 0 0"/>
  </joint>

  <link name="sensor_pole_link">
    <visual>
      <geometry><cylinder radius="${0.02*s}" length="${0.4*s}"/></geometry>
      <material name="pole_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="sensor_pole_joint" type="fixed">
    <parent link="cpu_box_link"/>
    <child link="sensor_pole_link"/>
    <origin xyz="${0.1*s} 0.0 ${0.3*s}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${0.04*s}" length="${0.06*s}"/></geometry>
      <material name="lidar_blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 ${0.23*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range><min>0.1</min><max>50.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry><box size="${0.03*s} ${0.1*s} ${0.03*s}"/></geometry>
      <material name="cam_black"><color rgba="0.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="camera_link"/>
    <origin xyz="${0.12*s} 0.0 ${0.1*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
