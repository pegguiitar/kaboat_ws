<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="wamv_kaboat">

  <!-- 크기 조정 가능한 선체 (base_link, 엔진, 배터리, 부력/유체동역학, 추력,
       상태 퍼블리셔 + 스케일 파라미터 s 를 여기서 정의한다).
       배 크기는 kaboat_hull.xacro 의 target_length 하나로 조정. -->
  <xacro:include filename="$(find kaboat_sim)/urdf/kaboat_hull.xacro" />

  <!-- 위 include 에서 정의된 s(= target_length/base_length)를 그대로 사용해
       센서 장착부(높이·크기)도 동일 비율로 축소한다. 센서 성능값(라이다 사거리,
       카메라 FOV/해상도 등)은 물리 치수가 아니므로 스케일하지 않는다. -->

  <link name="cpu_box_link">
    <visual>
      <geometry><box size="${0.4*s} ${0.3*s} ${0.2*s}"/></geometry>
      <material name="cpu_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${0.4*s} ${0.3*s} ${0.2*s}"/></geometry>
    </collision>
  </link>
  <joint name="cpu_box_joint" type="fixed">
    <parent link="wamv/base_link"/>
    <child link="cpu_box_link"/>
    <origin xyz="0.0 0.0 ${1.3*s}" rpy="0 0 0"/>
  </joint>

  <link name="sensor_pole_link">
    <visual>
      <geometry><cylinder radius="${0.02*s}" length="${0.4*s}"/></geometry>
      <material name="pole_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="sensor_pole_joint" type="fixed">
    <parent link="cpu_box_link"/>
    <child link="sensor_pole_link"/>
    <origin xyz="${0.1*s} 0.0 ${0.3*s}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${0.04*s}" length="${0.06*s}"/></geometry>
      <material name="lidar_blue"><color rgba="0.0 0.0 0.8 1.0"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 ${0.23*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/lidar/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <!-- 실물 TG-50: 최대 50m, 스캔 10Hz, 샘플 20kHz → 10Hz 에서 2000점/회전
           (각해상도 0.18°), 최소거리 0.05m, 거리정확도 ±2cm 수준 -->
      <lidar>
        <scan>
          <horizontal>
            <samples>2000</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.05</min><max>50.0</max><resolution>0.01</resolution></range>
        <!-- 라이다 noise 는 type 을 자식 요소로 쓴다 (camera/imu 의 속성 형식과 다름) -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual>
      <geometry><box size="${0.03*s} ${0.1*s} ${0.03*s}"/></geometry>
      <material name="cam_black"><color rgba="0.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="camera_link"/>
    <origin xyz="${0.12*s} 0.0 ${0.1*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <!-- 실물 Intel D455: depth FOV 87°(H)×58°(V), RGB FOV 90°(H)×65°(V),
           최대 해상도 1280×720. rgbd_camera 는 hfov 하나로 depth/RGB 공용이라
           depth 기준 87°(=1.5184rad)로 맞춤 (RGB 90° 와 3° 차 — 무시 가능).
           vfov 는 gz 가 종횡비(16:9)로 자동 계산 → 약 58° (실물 depth 58° 와 일치).
           clip far=100 은 RGB 지평선 렌더용 — 실물 depth 유효거리(≈0.6~6m,
           최대 ~20m) 밖의 뎁스는 인식 코드에서 무시할 것. -->
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU — 실물 EBIMU-9DOFv5-R3 (UART). sim 에서는 Gazebo imu 센서가
       sensor_msgs/Imu 로 바로 발행하므로 UART 파싱 불필요. 실물 전환 시
       이 노드만 UART 드라이버로 교체하고 토픽 인터페이스(/imu/data)는 유지. -->
  <link name="imu_link">
    <visual>
      <geometry><box size="${0.02*s} ${0.02*s} ${0.01*s}"/></geometry>
      <material name="imu_green"><color rgba="0.0 0.6 0.2 1.0"/></material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="wamv/base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 ${0.2*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- 노이즈: 이상적(무노이즈) 값이 아니라 실제 MEMS IMU 처럼 흔들리게.
           아래는 일반적인 MEMS AHRS 전형값 — EBIMU-9DOFv5-R3 데이터시트로
           재튜닝 필요(팀). 참고: gz 는 sensor_msgs/Imu 의 covariance 배열까지
           자동으로 채우진 않으므로, EKF 쪽에서 공분산을 별도 지정해야 한다. -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean><bias_stddev>8.0e-07</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean><bias_stddev>8.0e-07</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev><bias_mean>7.5e-06</bias_mean><bias_stddev>8.0e-07</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- GPS — 실물 기종 미정 (NMEA/serial 예상). sim 에서는 Gazebo navsat 센서가
       sensor_msgs/NavSatFix 로 발행. world 의 spherical_coordinates 원점 기준. -->
  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="${0.02*s}" length="${0.02*s}"/></geometry>
      <material name="gps_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="sensor_pole_link"/>
    <child link="gps_link"/>
    <origin xyz="0.0 0.0 ${0.26*s}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps_link">
    <sensor name="navsat_sensor" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <!-- 노이즈: 일반 소비자급 GPS 전형값(수평 ~1.5m, 수직 ~3m).
           실물 기종 확정 후 데이터시트로 재튜닝(팀).
           ⚠️ gz navsat 센서는 vertical(고도, m)은 그대로 미터로 적용하지만
           horizontal(위도/경도)은 미터→도 변환을 안 해주고 stddev 값을
           위경도 도(degree) 단위에 그대로 곱한다 (실측으로 확인 — stddev=1.5
           를 "1.5m" 로 넣었더니 실제로는 위도가 수백 km 급으로 흔들렸음).
           그래서 아래 값은 VRX 월드 원점(위도 -33.72°) 기준 1.5m 를
           도 단위로 환산한 근사값이다 (1.5 / 111320m ≈ 1.35e-5).
           위도가 크게 바뀌는 다른 월드로 옮기면 재계산 필요. -->
      <navsat>
        <position_sensing>
          <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>1.35e-5</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0.0</mean><stddev>3.0</stddev></noise></vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <!-- Odometry (sim 전용 ground truth) — mission_manager 의 2m 전환 판정과
       behavior 들의 위치 제어가 구독하는 /odom 의 sim 쪽 공급원.
       스폰 시점 pose 를 원점으로 하는 odom 좌표계로 발행한다 (스폰이 0,0 이므로
       world 좌표와 사실상 동일). 실물 전환 시 이 플러그인 대신
       robot_localization EKF (kaboat_bringup/config/ekf.yaml) 가 같은 /odom
       토픽으로 발행하면 상위 노드는 변경 없음. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>wamv/base_link</robot_base_frame>
      <odom_topic>/model/wamv_kaboat/odometry</odom_topic>
      <tf_topic>/model/wamv_kaboat/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>
