<?xml version="1.0"?>
<robot name="kaboat_msga">

  <link name="base_link">
    <inertial>
      <mass value="120.0"/> <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="4.5" ixy="0.0" ixz="0.0" iyy="15.0" iyz="0.0" izz="18.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="1.2 0.6 0.3"/>
      </geometry>
      <material name="purple_navy">
        <color rgba="0.2 0.1 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.2 0.6 0.3"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder length="0.06" radius="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.5 0.0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="depth_camera_link">
    <visual>
      <geometry><box size="0.03 0.1 0.03"/></geometry>
      <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="0.6 0.0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.2 0.0 0.3" rpy="0 0 0"/>
  </joint>


  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <update_rate>30</update_rate>
      <topic>/kaboat/laser/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples> <resolution>1</resolution>
            <min_angle>-3.141592</min_angle> <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples> <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>30.0</max> </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <update_rate>30</update_rate>
      <topic>/kaboat/camera</topic>
      <camera>
        <horizontal_fov>1.50098</horizontal_fov> <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15.0</far> </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate> <topic>/kaboat/imu/data</topic>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="gps_sensor" type="navsat">
      <always_on>1</always_on>
      <update_rate>10</update_rate> <topic>/kaboat/gps/fix</topic>
    </sensor>
  </gazebo>

  <!-- 부력 플러그인 -->
  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      
      <xU>-50.0</xU>         <xUabsU>-20.0</xUabsU>  <yV>-100.0</yV>        <yVabsV>-50.0</yVabsV>  <zW>-400.0</zW>        <zWabsW>-200.0</zWabsW> <kP>-50.0</kP>         <mQ>-50.0</mQ>         <nR>-20.0</nR>         </plugin>
  </gazebo>

</robot>