<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="buoy_cone_red">
    <link name="link">
      <inertial>
        <pose>0 0 -0.3 0 0 0</pose>
        <mass>50.0</mass>
        <inertia>
          <ixx>10.0</ixx>
          <iyy>10.0</iyy>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1.0</ambient>
          <diffuse>0.85 0.05 0.05 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- 원래 <cone> 으로 만들려 했으나 이 Gazebo(Garden/sdformat13) 는 cone
         geometry 를 지원하지 않아 <cylinder> 로 대체 (색상/위치/기능은 동일).
         부력 볼륨도 실제 collision 형상(반지름 0.35, 길이 0.9)과 일치시킴. -->
    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <fluid_density>1000</fluid_density>
      <fluid_level>0.0</fluid_level>
      <linear_drag>15.0</linear_drag>
      <angular_drag>1.0</angular_drag>
      <buoyancy name="collision_outer">
        <link_name>link</link_name>
        <pose>0 0 -0.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </buoyancy>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
  </model>
</sdf>
