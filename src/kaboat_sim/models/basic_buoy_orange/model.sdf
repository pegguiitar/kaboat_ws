<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="basic_buoy_orange">
    <link name="link">
      <!-- 2024-XX 크기 절반 축소 요청 반영: radius/length 를 정확히 절반(0.5x)으로
           줄이면 부피(=부력)는 0.5^3=1/8 로 줄어든다. 질량을 단순히 절반(1/2)으로
           줄이면 밀도가 오히려 4배(0.5 / 0.125)로 뛰어 물보다 훨씬 무거워져서
           가라앉는다 — 예전에 "반지름만 줄이고 질량 미조정"으로 침몰했던
           버그와 같은 함정. 그래서 질량은 부피와 같은 비율(1/8)로 줄여서
           밀도(≈478kg/m³, 원래 설계의 부력 여유)를 그대로 유지했다.
           관성모멘트도 동일한 결합비율(질량비×크기비²=1/8×1/4=1/32)로 축소. -->
      <inertial>
        <pose>0 0 -0.25 0 0 0</pose>
        <mass>138.9</mass>
        <inertia>
          <ixx>13.89</ixx>
          <iyy>13.89</iyy>
          <izz>6.94</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <capsule>
            <radius>0.26665</radius>
            <length>1.3</length>
          </capsule>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <capsule>
            <radius>0.26665</radius>
            <length>1.3</length>
          </capsule>
        </geometry>
        <material>
          <ambient>1.0 0.45 0.0 1.0</ambient>
          <diffuse>1.0 0.45 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>
    </link>

    <plugin name="vrx::PolyhedraBuoyancyDrag" filename="libPolyhedraBuoyancyDrag.so">
      <fluid_density>1000</fluid_density>
      <fluid_level>0.0</fluid_level>
      <linear_drag>25.0</linear_drag>
      <angular_drag>2.0</angular_drag>
      <buoyancy name="collision_outer">
        <link_name>link</link_name>
        <pose>0 0 -0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.26665</radius>
            <length>1.3</length>
          </cylinder>
        </geometry>
      </buoyancy>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
  </model>
</sdf>
