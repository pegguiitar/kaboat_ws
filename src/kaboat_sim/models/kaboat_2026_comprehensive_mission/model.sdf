<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="kaboat_2026_comprehensive_mission">
    <static>true</static>

    <!-- =====================================================================
         "그림 1 종합임무(1경기장)" 도면 배치.
         좌표계: 모델 원점 = 도면 좌하단 코너, +x = 오른쪽(가로 70m),
                 +y = 위쪽(세로 25m).
         도면에 정확한 치수가 없는 부분(오렌지 격자 각 열, 게이트 x 오프셋,
         도킹 구조물 정확한 계단 깊이)은 명시된 치수(3m 격자 간격, 5m 게이트
         간격, 12m/3m/1.5m/2m 도킹 치수 등)를 최대한 반영해 근사했습니다.
         GUI 로 실제 도면과 대조하며 조정이 필요할 수 있습니다.
    ===================================================================== -->

    <!-- ---- 좌측 구역 모서리 빨간 부표 4개 (30m 존 경계, "5m"/"2m"/"12m" 치수) ---- -->
    <include>
      <name>gate_red_left_top</name>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri>
      <pose>5 23 0 0 0 0</pose>
    </include>
    <include>
      <name>gate_red_left_bottom</name>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri>
      <pose>5 11 0 0 0 0</pose>
    </include>
    <include>
      <name>gate_red_mid_top</name>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri>
      <pose>25 23 0 0 0 0</pose>
    </include>
    <include>
      <name>gate_red_mid_bottom</name>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri>
      <pose>25 11 0 0 0 0</pose>
    </include>

    <!-- ---- 오렌지 장애물 격자 (3m 간격, 상/하단은 성기게, 중간 2줄은 6열 전부) ---- -->
    <!-- Row 1 (top, y=21): 4개 -->
    <include><name>obs_r1_1</name><uri>model://basic_buoy_orange</uri><pose>13 21 0 0 0 0</pose></include>
    <include><name>obs_r1_2</name><uri>model://basic_buoy_orange</uri><pose>16 21 0 0 0 0</pose></include>
    <include><name>obs_r1_3</name><uri>model://basic_buoy_orange</uri><pose>19 21 0 0 0 0</pose></include>
    <include><name>obs_r1_4</name><uri>model://basic_buoy_orange</uri><pose>22 21 0 0 0 0</pose></include>
    <!-- Row 2 (y=18): 6개 -->
    <include><name>obs_r2_1</name><uri>model://basic_buoy_orange</uri><pose>10 18 0 0 0 0</pose></include>
    <include><name>obs_r2_2</name><uri>model://basic_buoy_orange</uri><pose>13 18 0 0 0 0</pose></include>
    <include><name>obs_r2_3</name><uri>model://basic_buoy_orange</uri><pose>16 18 0 0 0 0</pose></include>
    <include><name>obs_r2_4</name><uri>model://basic_buoy_orange</uri><pose>19 18 0 0 0 0</pose></include>
    <include><name>obs_r2_5</name><uri>model://basic_buoy_orange</uri><pose>22 18 0 0 0 0</pose></include>
    <include><name>obs_r2_6</name><uri>model://basic_buoy_orange</uri><pose>25 18 0 0 0 0</pose></include>
    <!-- Row 3 (y=15): 6개 -->
    <include><name>obs_r3_1</name><uri>model://basic_buoy_orange</uri><pose>10 15 0 0 0 0</pose></include>
    <include><name>obs_r3_2</name><uri>model://basic_buoy_orange</uri><pose>13 15 0 0 0 0</pose></include>
    <include><name>obs_r3_3</name><uri>model://basic_buoy_orange</uri><pose>16 15 0 0 0 0</pose></include>
    <include><name>obs_r3_4</name><uri>model://basic_buoy_orange</uri><pose>19 15 0 0 0 0</pose></include>
    <include><name>obs_r3_5</name><uri>model://basic_buoy_orange</uri><pose>22 15 0 0 0 0</pose></include>
    <include><name>obs_r3_6</name><uri>model://basic_buoy_orange</uri><pose>25 15 0 0 0 0</pose></include>
    <!-- Row 4 (bottom, y=12): 2개 -->
    <include><name>obs_r4_1</name><uri>model://basic_buoy_orange</uri><pose>16 12 0 0 0 0</pose></include>
    <include><name>obs_r4_2</name><uri>model://basic_buoy_orange</uri><pose>19 12 0 0 0 0</pose></include>

    <!-- ---- 하단 채널(항로추종): 초록 삼각형 5개 / 빨간 삼각형 5개.
         x방향(같은 행 내 인접 부표 간) 5m, y방향(빨강-초록 행 간) 5m 간격.
         배는 이 채널을 왼쪽(x=5)에서 오른쪽(x=25 밖)으로 직진 통과한다. ---- -->
    <include><name>gate_green_1</name><uri>model://buoy_cone_green</uri><pose>5  5.5 0 0 0 0</pose></include>
    <include><name>gate_green_2</name><uri>model://buoy_cone_green</uri><pose>10 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_3</name><uri>model://buoy_cone_green</uri><pose>15 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_4</name><uri>model://buoy_cone_green</uri><pose>20 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_5</name><uri>model://buoy_cone_green</uri><pose>25 5.5 0 0 0 0</pose></include>
    <include><name>gate_red_1</name><uri>model://buoy_cone_red</uri><pose>5  0.5 0 0 0 0</pose></include>
    <include><name>gate_red_2</name><uri>model://buoy_cone_red</uri><pose>10 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_3</name><uri>model://buoy_cone_red</uri><pose>15 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_4</name><uri>model://buoy_cone_red</uri><pose>20 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_5</name><uri>model://buoy_cone_red</uri><pose>25 0.5 0 0 0 0</pose></include>

    <!-- ---- 우측 구역 (x: 49~70, 21m 존) ---- -->
    <!-- 오렌지-초록 쌍 (10m 가로 간격), 빨간 1개(4m 아래), 오렌지 1개(추가 5m 아래) -->
    <include><name>search_orange_1</name><uri>model://basic_buoy_orange</uri><pose>52 20 0 0 0 0</pose></include>
    <include><name>search_green_1</name><uri>model://basic_buoy_green</uri><pose>62 20 0 0 0 0</pose></include>
    <include><name>search_red_1</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri><pose>57 16 0 0 0 0</pose></include>
    <include><name>search_orange_2</name><uri>model://basic_buoy_orange</uri><pose>55 11 0 0 0 0</pose></include>

    <!-- ---- 도킹 접안 구조물 (파란 빗살, x=67~70 부근, 세로 12m) ---- -->
    <!-- 3개 이빨, 폭(세로) 1.5m, 이빨 사이 간격 2m, 깊이(가로) 3m 로 균일.
         2(간격)+1.5(이빨1)+2(간격)+1.5(이빨2)+2(간격)+1.5(이빨3)+2(간격) = 12.5m -->
    <link name="dock_structure">
      <pose>0 0 0.75 0 0 0</pose>

      <collision name="tooth1_collision">
        <pose>68.5 2.75 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
      </collision>
      <visual name="tooth1_visual">
        <pose>68.5 2.75 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <collision name="tooth2_collision">
        <pose>68.5 6.25 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
      </collision>
      <visual name="tooth2_visual">
        <pose>68.5 6.25 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <collision name="tooth3_collision">
        <pose>68.5 9.75 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
      </collision>
      <visual name="tooth3_visual">
        <pose>68.5 9.75 0 0 0 0</pose>
        <geometry><box><size>3.0 1.5 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- 뒷벽: 세 이빨을 x=70 선에서 지지하는 배경 벽 (선택적, 시각적 완성도용) -->
      <collision name="backwall_collision">
        <pose>70.4 6.25 0 0 0 0</pose>
        <geometry><box><size>0.8 12.5 1.5</size></box></geometry>
      </collision>
      <visual name="backwall_visual">
        <pose>70.4 6.25 0 0 0 0</pose>
        <geometry><box><size>0.8 12.5 1.5</size></box></geometry>
        <material>
          <ambient>0.08 0.2 0.6 1.0</ambient>
          <diffuse>0.08 0.2 0.6 1.0</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
