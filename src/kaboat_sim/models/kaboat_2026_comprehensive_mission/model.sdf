<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="kaboat_2026_comprehensive_mission">
    <static>true</static>

    <!-- =====================================================================
         "그림 1 종합임무(1경기장)" 도면 배치.
         좌표계: 모델 원점 = 도면 좌하단 코너, +x = 오른쪽(가로 70m),
                 +y = 위쪽(세로 25m).
         회피 구역은 사진 기반 흰 부표·연결 장애물로 교체했다(아래 include).
         도면에 정확한 치수가 없는 부분(게이트 x 오프셋,
         도킹 구조물 정확한 계단 깊이)은 명시된 치수(3m 격자 간격, 5m 게이트
         간격, 12m/3m/1.5m/2m 도킹 치수 등)를 최대한 반영해 근사했습니다.
         GUI 로 실제 도면과 대조하며 조정이 필요할 수 있습니다.
    ===================================================================== -->

    <!-- Photo-based avoidance arena (approximate dimensions).
         Local rectangle: x=5..32, y=11..24; world: x=5..32, y=71..84 (east-west 27 m = field survey 2026-11-12).
         White buoys + low red-orange booms + yellow float-rope boundary.
         Edit config/photo_arena.json and run scripts/generate_photo_arena.py.
         Fixed at the waterline: wave-following dynamics are not modelled yet. -->
    <include>
      <name>photo_avoidance</name>
      <uri>model://kaboat_photo_avoidance</uri>
      <pose>5 11 0 0 0 0</pose>
    </include>

    <!-- ==== 하단 채널(항로추종): 초록 삼각형 5개 / 빨간 삼각형 5개.
         x방향(같은 행 내 인접 부표 간) 5m, y방향(빨강-초록 행 간) 5m 간격.
         배는 이 채널을 왼쪽(x=5)에서 오른쪽(x=25 밖)으로 직진 통과한다. ==== -->
    <include><name>gate_green_1</name><uri>model://buoy_cone_green</uri><pose>5  5.5 0 0 0 0</pose></include>
    <include><name>gate_green_2</name><uri>model://buoy_cone_green</uri><pose>10 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_3</name><uri>model://buoy_cone_green</uri><pose>15 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_4</name><uri>model://buoy_cone_green</uri><pose>20 5.5 0 0 0 0</pose></include>
    <include><name>gate_green_5</name><uri>model://buoy_cone_green</uri><pose>25 5.5 0 0 0 0</pose></include>
    <include><name>gate_red_1</name><uri>model://buoy_cone_red</uri><pose>5  0.5 0 0 0 0</pose></include>
    <include><name>gate_red_2</name><uri>model://buoy_cone_red</uri><pose>10 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_3</name><uri>model://buoy_cone_red</uri><pose>15 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_4</name><uri>model://buoy_cone_red</uri><pose>20 0.5 0 0 0 0</pose></include>
    <include><name>gate_red_5</name><uri>model://buoy_cone_red</uri><pose>25 0.5 0 0 0 0</pose></include>

    <!-- ==== 우측 구역 (x: 49~70, 21m 존) ==== -->
    <!-- 오렌지-초록 쌍 (10m 가로 간격), 빨간 1개(4m 아래), 오렌지 1개(추가 5m 아래) -->
    <include><name>search_orange_1</name><uri>model://basic_buoy_orange</uri><pose>52 20 0 0 0 0</pose></include>
    <include><name>search_green_1</name><uri>model://basic_buoy_green</uri><pose>62 20 0 0 0 0</pose></include>
    <include><name>search_red_1</name><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri><pose>57 16 0 0 0 0</pose></include>
    <include><name>search_orange_2</name><uri>model://basic_buoy_orange</uri><pose>55 11 0 0 0 0</pose></include>

    <!-- ==== 도킹 접안 구조물 (파란 빗살, x=67.6~70 부근, 세로 15.9m) ====
         안쪽 슬롯 폭은 3.0→3.9m(1.3배), 돌출 핑거 깊이는
         3.0→2.4m(0.8배), 핑거 폭 1.05m는 유지.
         4×1.05 + 3×3.9 = 15.9m. 가운데 슬롯 y=6.0은 유지하고
         핑거 y중심 = -1.425 / 3.525 / 8.475 / 13.425.
         뒷벽 앞면은 x=70에서 세 슬롯을 가로질러 한 직선으로 이어지고,
         전체 범위는 y=-1.95~13.95다.
         ⚠️ 가라앉지 않음: 이 구조물은 model <static>true</static> 의 링크라
         중력·부력을 받지 않는 고정 지오메트리다(부표처럼 buoyancy 플러그인을
         쓰는 떠있는 물체가 아님). z: 링크 pose z=0.75 + 박스 높이 1.5 →
         z=0~1.5 로 수면(z=0) 위에 얹혀 고정. -->
    <link name="dock_structure">
      <pose>0 0 0.75 0 0 0</pose>

      <!-- 핑거 1 (하단 끝, y=-1.425) -->
      <collision name="finger1_collision">
        <pose>68.8 -1.425 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
      </collision>
      <visual name="finger1_visual">
        <pose>68.8 -1.425 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- 핑거 2 (y=3.525) -->
      <collision name="finger2_collision">
        <pose>68.8 3.525 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
      </collision>
      <visual name="finger2_visual">
        <pose>68.8 3.525 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- 핑거 3 (y=8.475) -->
      <collision name="finger3_collision">
        <pose>68.8 8.475 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
      </collision>
      <visual name="finger3_visual">
        <pose>68.8 8.475 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- 핑거 4 (상단 끝, y=13.425) -->
      <collision name="finger4_collision">
        <pose>68.8 13.425 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
      </collision>
      <visual name="finger4_visual">
        <pose>68.8 13.425 0 0 0 0</pose>
        <geometry><box><size>2.4 1.05 1.5</size></box></geometry>
        <material>
          <ambient>0.1 0.3 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- 뒷벽: 네 핑거를 x=70 선에서 지지하는 하나의 직선 벽 (y=-1.95~13.95) -->
      <collision name="backwall_collision">
        <pose>70.4 6.0 0 0 0 0</pose>
        <geometry><box><size>0.8 15.9 1.5</size></box></geometry>
      </collision>
      <visual name="backwall_visual">
        <pose>70.4 6.0 0 0 0 0</pose>
        <geometry><box><size>0.8 15.9 1.5</size></box></geometry>
        <material>
          <ambient>0.08 0.2 0.6 1.0</ambient>
          <diffuse>0.08 0.2 0.6 1.0</diffuse>
        </material>
      </visual>

      <!-- YOLO shape classes: circle / triangle / square. The markers sit just
           west of the back wall (x=70), face the approaching boat, and have no
           collision. Slot centres are y=1.05 / 6.0 / 10.95 in arena coordinates. -->
      <visual name="dock_mark_green_circle">
        <pose>69.95 1.05 2.25 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.5</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.9 0.05 1.0</ambient>
          <diffuse>0.02 0.9 0.05 1.0</diffuse>
          <emissive>0.01 0.2 0.01 1.0</emissive>
        </material>
      </visual>
      <visual name="dock_mark_red_triangle">
        <pose>69.95 6.0 2.25 0 0 0</pose>
        <geometry><mesh><uri>model://kaboat_2026_comprehensive_mission/meshes/triangle_marker.stl</uri></mesh></geometry>
        <material>
          <ambient>0.95 0.02 0.02 1.0</ambient>
          <diffuse>0.95 0.02 0.02 1.0</diffuse>
          <emissive>0.2 0.01 0.01 1.0</emissive>
        </material>
      </visual>
      <visual name="dock_mark_blue_square">
        <pose>69.95 10.95 2.25 0 0 0</pose>
        <geometry><box><size>0.04 1.0 1.0</size></box></geometry>
        <material>
          <ambient>0.02 0.1 0.95 1.0</ambient>
          <diffuse>0.02 0.1 0.95 1.0</diffuse>
          <emissive>0.01 0.02 0.2 1.0</emissive>
        </material>
      </visual>
    </link>

  </model>
</sdf>
